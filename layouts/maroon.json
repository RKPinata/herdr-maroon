{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "my-workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "my-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "my-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "usage",
          "type": "block",
          "content": {
            "mod": "my-usage"
          },
          "size": {
            "px": 62
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "my-workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tab-bar",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "my-annotator-tabs"
              },
              "size": {
                "weight": 1
              },
              "window_drag": true
            },
            {
              "id": "filer-pro-button",
              "type": "block",
              "content": {
                "mod": "my-filer-pro",
                "props": {
                  "button": true,
                  "listen": true
                }
              },
              "size": {
                "px": 0
              }
            }
          ],
          "size": {
            "px": 42
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "my-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "filer-pro",
                      "type": "block",
                      "content": {
                        "mod": "my-filer-pro"
                      },
                      "size": {
                        "weight": 1
                      },
                      "min": 120
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "my-annotator"
                      }
                    },
                    {
                      "id": "prs",
                      "type": "block",
                      "content": {
                        "mod": "my-pr-flow",
                        "props": {
                          "merge": "merge"
                        }
                      }
                    },
                    {
                      "id": "timeline",
                      "type": "block",
                      "content": {
                        "mod": "my-timeline"
                      }
                    },
                    {
                      "id": "linear",
                      "type": "block",
                      "content": {
                        "mod": "linear"
                      }
                    }
                  ],
                  "active": "filer-pro"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "my-workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "my-menu",
  "toast": "my-toast",
  "floating": [
    {
      "id": "my-nvim-sync",
      "content": {
        "mod": "my-nvim",
        "props": {
          "role": "sync"
        }
      },
      "edge": "bottom",
      "align": "end"
    }
  ]
}
